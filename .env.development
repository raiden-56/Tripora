# Committed, non-secret defaults for local Docker-based development.
# Consumed by docker-compose.yml (env_file: + ${VAR} interpolation) — see scripts/dev-up.ps1.
# Running the backend natively instead? Use `.env.example` -> `.env`, not this file.

ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Auth ---
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS: dockerized nginx frontend (8080) + native `npm run dev` (5173-5175) ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Rate limiting (requests per window per IP/user) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- Integrations (all optional; features degrade gracefully without them) ---
AI_API_KEY=
MAPS_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

PAYMENT_KEY=
PAYMENT_SECRET=
