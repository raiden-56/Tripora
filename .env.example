# Copy to .env and fill in real values. Never commit a real .env file.

ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Database ---
# Local dev default (no setup required): sqlite:///./travel_diaries.db
# Docker Compose / production: postgresql+psycopg://travel_diaries:travel_diaries@postgres:5432/travel_diaries
DATABASE_URL=sqlite:///./travel_diaries.db

# --- Redis (caching, rate limiting, Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Rate limiting (requests per window per IP/user) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- Integrations (all optional; features degrade gracefully without them) ---
AI_API_KEY=
MAPS_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

PAYMENT_KEY=
PAYMENT_SECRET=
