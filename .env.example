# Every value below already works as-is for local development — copy this file to
# .env and run, no edits required. (Never commit the real .env file — it's gitignored.)
#
# This file is only read when running the backend natively (uvicorn directly, or
# scripts/dev-up-local.sh / dev-up-local.ps1). The Docker Compose path
# (scripts/dev-up.sh / dev-up.ps1) ignores this file entirely and gets its config —
# including the real Postgres URL — from .env.development instead.

ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Database ---
# SQLite by default: zero setup, no Postgres install required to run this app locally.
# Same models/migrations work against Postgres too — only relevant if you're running
# the backend natively AND want it to talk to the Dockerized Postgres from dev-up.sh
# (docker-compose.yml exposes it on localhost:5433): swap the line below for
# DATABASE_URL=postgresql+psycopg://travel_diaries:travel_diaries@localhost:5433/travel_diaries
DATABASE_URL=sqlite:///./travel_diaries.db

# --- Redis (caching, rate limiting, Celery broker/backend) ---
# Optional here too — every feature that uses Redis degrades to "disabled" (never
# crashes) if it isn't reachable. Leave as-is unless you're running Redis locally.
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Fine to leave as-is for local dev/testing — only rotate this for a real deployment.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Rate limiting (requests per window per IP/user) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# --- Integrations (all optional; features degrade gracefully without them) ---
AI_API_KEY=
MAPS_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

PAYMENT_KEY=
PAYMENT_SECRET=
